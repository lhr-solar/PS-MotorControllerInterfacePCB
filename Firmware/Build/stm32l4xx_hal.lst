 103:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** /** @defgroup HAL_Exported_Functions_Group1 Initialization and de-initialization Functions
 104:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****  *  @brief    Initialization and de-initialization functions
 105:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****  *
 106:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** @verbatim
 107:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****  ===============================================================================
 108:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****               ##### Initialization and de-initialization functions #####
 109:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****  ===============================================================================
 110:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****     [..]  This section provides functions allowing to:
 111:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****       (+) Initialize the Flash interface, the NVIC allocation and initial time base
 112:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****           clock configuration.
 113:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****       (+) De-initialize common part of the HAL.
 114:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****       (+) Configure the time base source to have 1ms time base with a dedicated
 115:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****           Tick interrupt priority.
 116:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****         (++) SysTick timer is used by default as source of time base, but user
 117:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              can eventually implement his proper time base source (a general purpose
 118:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              timer for example or other time source), keeping in mind that Time base
 119:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              duration should be kept 1ms since PPP_TIMEOUT_VALUEs are defined and
 120:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              handled in milliseconds basis.
 121:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****         (++) Time base configuration function (HAL_InitTick ()) is called automatically
 122:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              at the beginning of the program after reset by HAL_Init() or at any time
 123:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              when clock is configured, by HAL_RCC_ClockConfig().
 124:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****         (++) Source of time base is configured  to generate interrupts at regular
 125:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              time intervals. Care must be taken if HAL_Delay() is called from a
 126:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              peripheral ISR process, the Tick interrupt line must have higher priority
 127:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****             (numerically lower) than the peripheral interrupt. Otherwise the caller
 128:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****             ISR process will be blocked.
 129:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****        (++) functions affecting time base configurations are declared as __weak
 130:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****              to make  override possible  in case of other  implementations in user file.
 131:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** @endverbatim
 132:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   * @{
 133:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   */
 134:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** 
 135:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** /**
 136:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   * @brief  Configure the Flash prefetch, the Instruction and Data caches,
 137:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         the time base source, NVIC and any required global low level hardware
 138:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         by calling the HAL_MspInit() callback function to be optionally defined in user file
 139:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         stm32l4xx_hal_msp.c.
 140:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *
 141:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   * @note   HAL_Init() function is called at the beginning of program after reset and before
 142:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         the clock configuration.
 143:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *
 144:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   * @note   In the default implementation the System Timer (Systick) is used as source of time base
ARM GAS  /var/tmp//ccxjZTaK.s 			page 4


 145:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         The Systick configuration is based on MSI clock, as MSI is the clock
 146:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         used after a system Reset and the NVIC configuration is set to Priority group 4.
 147:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         Once done, time base tick starts incrementing: the tick variable counter is incremented
 148:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *         each 1ms in the SysTick_Handler() interrupt handler.
 149:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   *
 150:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   * @retval HAL status
 151:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   */
 152:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** HAL_StatusTypeDef HAL_Init(void)
 153:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** {
 154:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   HAL_StatusTypeDef  status = HAL_OK;
 155:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c **** 
 156:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   /* Configure Flash prefetch, Instruction cache, Data cache */
 157:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   /* Default configuration at reset is:                      */
 158:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   /* - Prefetch disabled                                     */
 159:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal.c ****   /* - Instruction cache enabled                             */
