 755:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   * @param  Timeout Timeout duration.
 756:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   * @retval HAL status
 757:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   */
 758:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c **** HAL_StatusTypeDef HAL_USART_Transmit(USART_HandleTypeDef *husart, const uint8_t *pTxData, uint16_t 
 759:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****                                      uint32_t Timeout)
 760:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c **** {
 761:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   const uint8_t  *ptxdata8bits;
 762:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   const uint16_t *ptxdata16bits;
 763:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   uint32_t tickstart;
 764:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c **** 
 765:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   if (husart->State == HAL_USART_STATE_READY)
 766:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****   {
 767:stm/stm32l4xx/STM32L4xx_HAL_Driver/Src/stm32l4xx_hal_usart.c ****     if ((pTxData == NULL) || (Size == 0U))
